<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The Stay ZIP attack tests take many minutes. They run only with -p:RunStayTests=true
         (CI does that when the attack's code changes, see .github/workflows/stay-tests.yml).
         Slow tests (GPU work through hashcat, for example ZipGpuKernelSlowTests) run only with
         -p:RunSlowTests=true, or when selected with an explicit dotnet test filter. -->
    <VSTestTestCaseFilter Condition="'$(RunStayTests)' != 'true' and '$(RunSlowTests)' != 'true'">Category!=Stay&amp;Category!=Slow</VSTestTestCaseFilter>
    <VSTestTestCaseFilter Condition="'$(RunStayTests)' == 'true' and '$(RunSlowTests)' != 'true'">Category!=Slow</VSTestTestCaseFilter>
    <VSTestTestCaseFilter Condition="'$(RunStayTests)' != 'true' and '$(RunSlowTests)' == 'true'">Category!=Stay</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/Wordlists/*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/Wallets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RecoverKit.Core\RecoverKit.Core.csproj" />
    <Compile Include="../../src/RecoverKit.App/Ui/SpeedProbe.cs" Link="SpeedProbe.cs" />
    <None Update="Fixtures\SevenZip\*.7z" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures/KeePass/*" />
    <EmbeddedResource Include="Fixtures/Rar3Kdf/*.rar" />
    <EmbeddedResource Include="Fixtures/android-v*.ab" />
    <EmbeddedResource Include="Fixtures/Access/*.bin" />
    <EmbeddedResource Include="Fixtures/Word/*" />
    <EmbeddedResource Include="Fixtures/Spreadsheets/*.xlsx" />
    <EmbeddedResource Include="Fixtures/Spreadsheets/*.xls" />
    <EmbeddedResource Include="Fixtures/Office/*" />
    <EmbeddedResource Include="Fixtures/Pdf/*.pdf" />
    <EmbeddedResource Include="Fixtures/OfficeXor/*" />
    <EmbeddedResource Include="Fixtures/Rar3/*.gz" />
  </ItemGroup>

</Project>
