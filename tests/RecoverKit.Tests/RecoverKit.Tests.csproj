<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The Stay ZIP attack tests take many minutes. They run only with -p:RunStayTests=true
         (CI does that when the attack's code changes, see .github/workflows/stay-tests.yml). -->
    <VSTestTestCaseFilter Condition="'$(RunStayTests)' != 'true'">Category!=Stay</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/Wallets/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RecoverKit.Core\RecoverKit.Core.csproj" />
    <None Update="Fixtures\SevenZip\*.7z" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures/KeePass/*" />
    <EmbeddedResource Include="Fixtures/android-v*.ab" />
    <EmbeddedResource Include="Fixtures/Access/*.bin" />
    <EmbeddedResource Include="Fixtures/Word/*" />
    <EmbeddedResource Include="Fixtures/Spreadsheets/*.xlsx" />
    <EmbeddedResource Include="Fixtures/Spreadsheets/*.xls" />
  </ItemGroup>

</Project>
